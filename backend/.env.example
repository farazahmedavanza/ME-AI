# Copy to .env and adjust. Defaults work for local-only demo.
JWT_SECRET=dev-local-jwt-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USE_LOCAL_STORE=1
# USE_DEGRADED_MODE=1
# Same effect as USE_LOCAL_STORE — force SQLite only.
# STORE_AUTO_FALLBACK=0
# When 0, Supabase must connect or the API will error. Default is 1 (fall back to SQLite).
# Optional OpenRouter (incident reports)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
# Local Ollama — only used for "Import text / Rdv / other log file" uploads (API health blurb).
# Run `ollama serve`, then e.g. `ollama pull llama3.2`, set:
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_S=120
# Supabase (optional; leave empty to use SQLite)
# SUPABASE_URL=
# SUPABASE_KEY=   # service role for backend; also used by scripts/seed_supabase_auth.py
# SUPABASE_JWT_SECRET=
# Create Auth users demo@me-ai.local + ops@me-ai.local (password DemoME2026!):
#   python scripts/seed_supabase_auth.py
# Live monitoring: JSON snapshot for Overview (background interval & path)
# LIVE_MONITOR_SNAPSHOT_INTERVAL_SEC=420
# LIVE_MONITOR_SNAPSHOT_PATH=./data/live_monitor_snapshot.json
# When an endpoint has no per-endpoint `alert_email`, this address is used
# DEFAULT_MONITOR_ALERT_EMAIL=meaiavanzahackathon@gmail.com
# SMTP (optional; tried first if USER + PASSWORD are set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
#
# If SMTP is not configured or fails, the backend tries in order:
# 1) Resend HTTPS API (optional free tier — get a key at resend.com)
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# Resend test mode may only allow sending to your Resend sign-up address. If so, set
# the same address here; the real alert addressee is still included in the email body.
# ALERT_DELIVERY_TO_OVERRIDE=you@resend-signup-inbox.com
#
# 2) FormSubmit public relay — no key; POST to formsubmit.co/ajax/{recipient}
#    First delivery to a new address may require a one-time activation email from FormSubmit.
# USE_FORM_SUBMIT_EMAIL_FALLBACK=1
