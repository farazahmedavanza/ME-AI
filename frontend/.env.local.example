# FastAPI base URL (optional locally). If set to http://127.0.0.1:8000 or http://localhost:8000,
# the browser still calls same-origin /api/* and Next.js proxies (see next.config.mjs) to avoid CORS.
# For a remote API (e.g. production), set this to that origin; CORS must allow your Next site.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where Next.js proxies /api/* (server-side only). Defaults to http://127.0.0.1:8000
# BACKEND_URL=http://127.0.0.1:8000

# Optional Supabase (if you add login with Supabase Auth on the client)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
